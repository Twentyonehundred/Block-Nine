rules_version = '2';

// Block Nine leaderboards.
//
// One collection per game mode, each holding one document per player at {collection}/{uid}.
// Anyone signed in can read the boards; a player may only write their own document, and only
// with a well-formed shape. Every board is the same shape, so the validation is written once
// here and applied to each collection.
//
// Note the honest limitation: the score itself is supplied by the client, so these rules can
// stop someone editing a rival's row but cannot prove a score was really earned. Enforcing
// that needs a server-side submission (a Cloud Function holding the game rules).
service cloud.firestore {
  match /databases/{database}/documents {

    // Scores are non-negative ints with a sane ceiling, the bucket keys are the expected
    // shape, and the display name is bounded so a row can't be used as free storage.
    function isWellFormed(d) {
      return d.keys().hasOnly(['name', 'best', 'dayKey', 'dayBest', 'monthKey', 'monthBest', 'updatedAt'])
             && d.name is string && d.name.size() > 0 && d.name.size() <= 60
             && isScore(d.best) && isScore(d.dayBest) && isScore(d.monthBest)
             && d.dayKey is string && d.dayKey.matches('^\\d{4}-\\d{2}-\\d{2}$')
             && d.monthKey is string && d.monthKey.matches('^\\d{4}-\\d{2}$')
             && d.dayBest <= d.best && d.monthBest <= d.best;
    }

    function isScore(v) {
      return v is int && v >= 0 && v <= 10000000;
    }

    // The all-time best may only ever go up. The dated bests are allowed to drop, but only
    // when their bucket has actually rolled over to a new day or month. `resource` is null on
    // a create, which is the first row and so has nothing to lower.
    function neverLowersATotal() {
      return resource == null
             || (
                  request.resource.data.best >= resource.data.best
                  && (request.resource.data.dayKey != resource.data.dayKey
                      || request.resource.data.dayBest >= resource.data.dayBest)
                  && (request.resource.data.monthKey != resource.data.monthKey
                      || request.resource.data.monthBest >= resource.data.monthBest)
                );
    }

    function isOwnValidRow(uid) {
      return request.auth != null
             && request.auth.uid == uid
             && isWellFormed(request.resource.data)
             && neverLowersATotal();
    }

    // Classic. Keeps the original collection name so existing rows keep their history.
    match /players/{uid} {
      allow read: if request.auth != null;
      allow write: if isOwnValidRow(uid);
    }

    // Rising Tide.
    match /tidePlayers/{uid} {
      allow read: if request.auth != null;
      allow write: if isOwnValidRow(uid);
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
