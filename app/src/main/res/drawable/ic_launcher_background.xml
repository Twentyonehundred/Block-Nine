<?xml version="1.0" encoding="utf-8"?>
<!--
    Diagonal wash of the app's tile blue. A gradient rather than a flat fill so the mark keeps
    some depth once a launcher shrinks it; the darker corner sits bottom-right, away from the
    grid's lit middle row.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <path android:pathData="M0,0 h108 v108 h-108 z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="0"
                android:startY="0"
                android:endX="108"
                android:endY="108"
                android:startColor="#5B96F9"
                android:endColor="#1D4ED8" />
        </aapt:attr>
    </path>
</vector>
