<?xml version="1.0" encoding="utf-8"?>
<!--
    A 3x3 of tiles with the middle row lit: the moment a line completes, which is the whole game.

    Geometry is deliberately exact. Tiles are 12 wide on a 15 pitch starting at 33, so the mark
    spans 33..75 and its centre lands on (54, 54) — the centre of the 108x108 adaptive-icon
    viewport. Its furthest corner sits ~30 from that centre, inside the 33 keyline radius, so no
    launcher mask clips it and there is real margin between the grid and the icon's edge.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Top row: still waiting to be filled. -->
    <path android:fillColor="#73FFFFFF" android:pathData="M36,33 h6 a3,3 0 0 1 3,3 v6 a3,3 0 0 1 -3,3 h-6 a3,3 0 0 1 -3,-3 v-6 a3,3 0 0 1 3,-3 z" />
    <path android:fillColor="#73FFFFFF" android:pathData="M51,33 h6 a3,3 0 0 1 3,3 v6 a3,3 0 0 1 -3,3 h-6 a3,3 0 0 1 -3,-3 v-6 a3,3 0 0 1 3,-3 z" />
    <path android:fillColor="#73FFFFFF" android:pathData="M66,33 h6 a3,3 0 0 1 3,3 v6 a3,3 0 0 1 -3,3 h-6 a3,3 0 0 1 -3,-3 v-6 a3,3 0 0 1 3,-3 z" />

    <!-- Middle row: complete, so it burns bright. -->
    <path android:fillColor="#FFFFFFFF" android:pathData="M36,48 h6 a3,3 0 0 1 3,3 v6 a3,3 0 0 1 -3,3 h-6 a3,3 0 0 1 -3,-3 v-6 a3,3 0 0 1 3,-3 z" />
    <path android:fillColor="#FFFFFFFF" android:pathData="M51,48 h6 a3,3 0 0 1 3,3 v6 a3,3 0 0 1 -3,3 h-6 a3,3 0 0 1 -3,-3 v-6 a3,3 0 0 1 3,-3 z" />
    <path android:fillColor="#FFFFFFFF" android:pathData="M66,48 h6 a3,3 0 0 1 3,3 v6 a3,3 0 0 1 -3,3 h-6 a3,3 0 0 1 -3,-3 v-6 a3,3 0 0 1 3,-3 z" />

    <!-- Bottom row: still waiting to be filled. -->
    <path android:fillColor="#73FFFFFF" android:pathData="M36,63 h6 a3,3 0 0 1 3,3 v6 a3,3 0 0 1 -3,3 h-6 a3,3 0 0 1 -3,-3 v-6 a3,3 0 0 1 3,-3 z" />
    <path android:fillColor="#73FFFFFF" android:pathData="M51,63 h6 a3,3 0 0 1 3,3 v6 a3,3 0 0 1 -3,3 h-6 a3,3 0 0 1 -3,-3 v-6 a3,3 0 0 1 3,-3 z" />
    <path android:fillColor="#73FFFFFF" android:pathData="M66,63 h6 a3,3 0 0 1 3,3 v6 a3,3 0 0 1 -3,3 h-6 a3,3 0 0 1 -3,-3 v-6 a3,3 0 0 1 3,-3 z" />
</vector>
